# Consulta de Estoque — manual inventory sync credentials
# Copy to  scripts/sync-estoque/.env  and fill in.  .env is gitignored.
# These are SERVER-SIDE ops secrets. Never commit real values. Never put the
# service_role key in browser/Vite code.

# --- Linx SQL Server (on-prem) --------------------------------------------
# Authoritative context: the same SSMS connection used for the inventory
# diagnostics.  aplserver resolves to aplserver.benvisi.local / 192.168.0.201
# and TCP 1433 is reachable from this PC (default instance, no SQL Browser).
LINX_SQL_SERVER=aplserver
LINX_SQL_PORT=1433
LINX_SQL_DATABASE=Lacoste_60420
LINX_SQL_USER=sa
LINX_SQL_PASSWORD=
# 'false' for a plain on-prem LAN connection; 'true' only if the server
# requires TLS. The script always sends trustServerCertificate=true.
LINX_SQL_ENCRYPT=false
# Locked store filter — note the DOUBLE space. Only change if the Linx value changes.
LINX_FILIAL=LACOSTE SHOPPING  MANAUS

# --- Supabase (destination) --------------------------------------------------
# Same value as VITE_SUPABASE_URL in the repo root .env
SUPABASE_URL=https://ugfogsseikupsfqqznzi.supabase.co
# Supabase dashboard -> Project Settings -> API -> service_role (secret).
# Needed because estoque_staging_grupos/estoque_staging_linhas have RLS
# enabled with zero policies, so the publishable/anon key cannot write to
# them. Keep this key only in this file.
SUPABASE_SERVICE_ROLE_KEY=
