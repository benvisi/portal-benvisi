# Salesperson Metrics — dry-run reconciliation credentials
# Copy to  scripts/sales-metrics-reconciliation/.env  and fill in.
# .env is gitignored (repo-wide *.env rule). This tool makes NO Supabase
# calls, so no Supabase secret is needed here at all.

# --- Linx SQL Server (on-prem) --------------------------------------------
# Same server as the inventory sync (scripts/sync-estoque). Prefer a
# dedicated READ-ONLY SQL login scoped to at least dbo.LOJA_VENDA,
# dbo.LOJA_VENDA_VENDEDORES, dbo.LOJA_VENDEDORES if one exists; this tool
# never issues a write, but least-privilege credentials are a second line of
# defense, not just this script's own promise.
LINX_SQL_SERVER=aplserver
LINX_SQL_PORT=1433
LINX_SQL_DATABASE=Lacoste_60420
LINX_SQL_USER=sa
LINX_SQL_PASSWORD=
# 'false' for a plain on-prem LAN connection; 'true' only if the server
# requires TLS. The script always sends trustServerCertificate=true.
LINX_SQL_ENCRYPT=false

# Note: CODIGO_FILIAL (e.g. 060420) is a CLI argument (--filial), not an env
# var — it varies per invocation, unlike the LOJA_VENDA store-name filter
# used by the inventory sync.
