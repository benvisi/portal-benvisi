# Lacoste product-image worker — credentials
# Copy to  scripts/sync-produto-imagens/.env  and fill in. .env is gitignored
# (via the repo root .gitignore's unanchored `.env` / `node_modules` patterns
# — no nested .gitignore needed in this directory).
# These are SERVER-SIDE ops secrets. Never commit real values. Never put any
# of these in browser/Vite code — this worker is never imported by src/.

# --- Supabase (destination) --------------------------------------------------
# Same value as VITE_SUPABASE_URL in the repo root .env
SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API -> service_role (secret).
# Needed because produto_imagem_* tables have RLS enabled with zero policies,
# so the publishable/anon key cannot write to them. Keep this key only in
# this file. (Added once the Slice 1 schema exists — not required to pass
# Slice 0's validation checks.)
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Tier 2 candidate scoring — materially-different front/back
# and complete-vs-crop judgments only; Tier 1 person detection is local and
# needs no key) ----------------------------------------------------------------
# https://console.anthropic.com/ -> API Keys. Not called in Slice 0.
ANTHROPIC_API_KEY=
