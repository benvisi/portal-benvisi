# Salesperson Metrics — production sync credentials
# Copy to  scripts/sales-metrics-sync/.env  and fill in.  .env is gitignored.
# These are SERVER-SIDE ops secrets. Never commit real values. Never put the
# service_role key in browser/Vite code.

# --- Linx SQL Server (on-prem) --------------------------------------------
# Same server as scripts/sync-estoque and scripts/sales-metrics-reconciliation.
LINX_SQL_SERVER=aplserver
LINX_SQL_PORT=1433
LINX_SQL_DATABASE=Lacoste_60420
LINX_SQL_USER=sa
LINX_SQL_PASSWORD=
# 'false' for a plain on-prem LAN connection; 'true' only if the server
# requires TLS. The script always sends trustServerCertificate=true.
LINX_SQL_ENCRYPT=false

# --- Supabase (destination) --------------------------------------------------
# Same value as VITE_SUPABASE_URL in the repo root .env
SUPABASE_URL=https://ugfogsseikupsfqqznzi.supabase.co
# Supabase dashboard -> Project Settings -> API -> service_role (secret).
# Needed because vendas_diarias_vendedor has RLS enabled with zero policies
# and all writes/mapping-reads go through SECURITY DEFINER RPCs granted only
# to service_role (vendas_diarias_substituir_dia,
# vendas_diarias_mapeamento_vendedores). Keep this key only in this file.
SUPABASE_SERVICE_ROLE_KEY=
